{
  "name": "ASP.NET + Angular",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24" 
    }
  },
  
  "forwardPorts": [5000, 4200],
  
  // Cleanly install everything. Note: No need for -g if we use npx in tasks.
  // npx is generally preferred in Docker rather than angular cli
  "postCreateCommand": "dotnet restore && cd Frontend && npm install",

  "remoteUser": "vscode"
}